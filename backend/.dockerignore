# .dockerignore

# Node modules (always ignore, will be installed in image)
node_modules
.pnpm
.pnp.*
npm-debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
.next
out
dist
build

# Local env files (optional, unless you want to copy them)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS/Editor files
.DS_Store
*.swp
*.swo
*.idea
.vscode

# Misc
coverage
*.log