version: '3.8'
services:
  backend:
    build: ./backend
    container_name: portal-backend
    ports:
      - "3001:3001"
    environment:
      - NODE_ENV=production
      - DB_USER=postgres
      - DB_PASSWORD=letmein
      - DB_HOST=host.docker.internal
      - DB_PORT=5432
      - DB_DATABASE=portal
      - SWAGGER_SERVER_URL=http://backend:3001/api/v1
    command: npm start

  frontend:
    build: ./frontend
    container_name: portal-frontend
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
      - NEXT_PUBLIC_API_URL=http://backend:3001/api/v1
      - NEXT_PUBLIC_RELATIVE_API_BASE=/api/v1
    depends_on:
      - backend